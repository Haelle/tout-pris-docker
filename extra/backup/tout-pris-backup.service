[Unit]
Description=Sauvegarde de la base SQLite de Tout Pris
Documentation=https://github.com/Haelle/tout-pris-docker
# Point d'accroche pour l'alerting : une unité de notification déclenchée
# quand la sauvegarde échoue.
# OnFailure=alerte@%n.service

[Service]
Type=oneshot
# Le script travaille en chemins relatifs : c'est ici que se règle l'endroit
# où le dépôt est déployé. Les deux lignes suivantes sont les seules à ajuster.
WorkingDirectory=/srv/tout-pris
ExecStart=/srv/tout-pris/extra/backup/backup.sh
