# Copier en `.env` et ajuster. Ce fichier est lu automatiquement par
# `docker compose`. Le vrai `.env` n'est pas versionné (voir .gitignore).

# --- Images ------------------------------------------------------------------
# Publiées par la CI de chaque dépôt : `dev` suit main, `latest` suit le dernier
# tag, et les tags semver (1, 1.2, 1.2.3) permettent d'épingler une version.
#
# Un tag semver rend les déploiements explicites et les rollbacks triviaux ;
# un tag mobile (`latest`, `dev`) est ce qu'attend Watchtower pour détecter une
# nouvelle version. Choisissez selon que vous voulez décider des mises à jour
# ou qu'elles se fassent seules — pas les deux.
API_IMAGE=estb/tout-pris-back
API_TAG=latest
FRONT_IMAGE=estb/tout-pris-front
FRONT_TAG=latest

# --- Ports publiés par le reverse proxy --------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# --- Base de données ---------------------------------------------------------
# SQLite, dans le volume `db_data`. Quatre slashes = chemin absolu.
DATABASE_URL=sqlite:////data/tout_pris.db

# --- Sauvegardes -------------------------------------------------------------
# Intervalle en secondes : 86400 = quotidien, 21600 = toutes les 6 h.
BACKUP_INTERVAL=86400
# Nombre d'archives conservées dans ./backups.
BACKUP_RETENTION=14
SQLITE_PATH=/data/tout_pris.db

# URL pingée après chaque sauvegarde réussie (healthchecks.io, Cronitor…).
# Laissée vide, aucune supervision : vous ne saurez pas que ça a cassé.
HEALTHCHECK_URL=

# --- Mises à jour automatiques -----------------------------------------------
# Utilisées par le service `watchtower`, commenté dans compose.yaml.
TZ=Europe/Paris
# Notifications shoutrrr (discord://…, slack://…, gotify://…, smtp://…).
# WATCHTOWER_NOTIFICATION_URL=
